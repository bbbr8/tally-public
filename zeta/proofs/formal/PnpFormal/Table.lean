/-
Table.lean — data from the lab's exhaustive search (lean_pass.sizes_with_witnesses), and the finite checks Lean runs on it.
Generated by `python3 lean_pass.py formal`; do not edit by hand.

The data is used only as a certificate.  Nothing in the proofs assumes it is right: Parity.lean and Exact.lean
derive every theorem from the checks below, which Lean evaluates itself.
-/
namespace PnpFormal

/-- 65,536 characters; character `t` is `'A' + size` for the 4-variable function with truth table `t`. -/
def tblStr : String := ""
/-- For each function of size at least 2: the truth tables of two smaller functions (4 hex digits each) ... -/
def wxStr : String := ""
def wyStr : String := ""
/-- ... and whether they are joined by AND (`A`) or OR (`O`). -/
def wopStr : String := ""

def tbl : ByteArray := tblStr.toUTF8
def wxB : ByteArray := wxStr.toUTF8
def wyB : ByteArray := wyStr.toUTF8
def wopB : ByteArray := wopStr.toUTF8

/-- Claimed formula size of the function with truth table `t`. -/
def s (t : Nat) : Nat := (tbl.get! t).toNat - 65

def hexVal (b : UInt8) : Nat := if b.toNat < 58 then b.toNat - 48 else b.toNat - 55
def hex4 (a : ByteArray) (t : Nat) : Nat :=
  hexVal (a.get! (4 * t)) * 4096 + hexVal (a.get! (4 * t + 1)) * 256 + hexVal (a.get! (4 * t + 2)) * 16 + hexVal (a.get! (4 * t + 3))
def wx (t : Nat) : Nat := hex4 wxB t
def wy (t : Nat) : Nat := hex4 wyB t
def wor (t : Nat) : Bool := wopB.get! t == 79

/-- `p i` for every `i < n`. -/
def allBelow : Nat → (Nat → Bool) → Bool
  | 0, _ => true
  | n + 1, p => p n && allBelow n p

def litTables : List Nat := [0xAAAA, 0x5555, 0xCCCC, 0x3333, 0xF0F0, 0x0F0F, 0xFF00, 0x00FF]

/-- The eight literals have size at most 1. -/
def checkLits : Bool := litTables.all fun t => decide (s t ≤ 1)

/-- Closure: whenever `s x ≤ s y` and `s x + s y ≤ 15`, both `x AND y` and `x OR y` have size at most `s x + s y`. -/
def checkClosed : Bool :=
  allBelow 65536 fun x => decide (7 < s x) || allBelow 65536 fun y =>
    decide (s y < s x) || decide (15 < s x + s y) ||
      (decide (s (x &&& y) ≤ s x + s y) && decide (s (x ||| y) ≤ s x + s y))

/-- No entry exceeds 16. -/
def checkMax : Bool := allBelow 65536 fun t => decide (s t ≤ 16)

/-- Every entry equal to 1 is one of the eight literals. -/
def checkOnes : Bool := allBelow 65536 fun t => decide (s t ≠ 1) || litTables.contains t

/-- Every entry of 2 or more comes with two smaller functions whose sizes add up to it and which combine to it. -/
def checkBuild : Bool :=
  allBelow 65536 fun t => decide (s t < 2) ||
    (decide (wx t < 65536) && decide (wy t < 65536) && decide (1 ≤ s (wx t)) && decide (1 ≤ s (wy t)) &&
     decide (s (wx t) + s (wy t) = s t) && (if wor t then wx t ||| wy t == t else wx t &&& wy t == t))

/-- Number of functions whose entry is exactly `k`. -/
def countAt (k : Nat) : Nat := (List.range 65536).countP fun t => s t == k

end PnpFormal
