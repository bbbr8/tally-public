/-
Maj5.lean — generated by `python3 lean_pass.py maj5` (copy of lean/Maj5.lean) from the circuit found in loop 15 (MCSP_RESULTS.json).

Upper bound only.  The theorem says: this list of 9 two-input gates computes the majority of five bits on all 32 inputs.
That no circuit with fewer gates exists is the solvers' claim (two solvers on the lab's clauses, with the argument in
mcsp.SYMMETRY); it is not a theorem in this file.  Not a statement about P vs NP.
-/
namespace PnpFormal.Maj5

/-- A two-input gate that is 0 on (0, 0): the nodes it reads (1-based; nodes 1..5 are the inputs) and its values on
(1,0), (0,1), (1,1). -/
structure Gate where
  j : Nat
  l : Nat
  f10 : Bool
  f01 : Bool
  f11 : Bool

def Gate.app (g : Gate) (a b : Bool) : Bool :=
  match a, b with
  | false, false => false
  | true, false => g.f10
  | false, true => g.f01
  | true, true => g.f11

/-- Run the gates left to right; `vals` holds the nodes so far (node k at position k - 1). -/
def run : List Gate → List Bool → List Bool
  | [], vals => vals
  | g :: gs, vals => run gs (vals ++ [g.app (vals.getD (g.j - 1) false) (vals.getD (g.l - 1) false)])

/-- Every gate reads two different nodes that already exist. -/
def wellFormed : List Gate → Nat → Bool
  | [], _ => true
  | g :: gs, n => decide (1 ≤ g.j ∧ g.j < g.l ∧ g.l ≤ n) && wellFormed gs (n + 1)

/-- No gate is constant 0 or a copy of one of its inputs. -/
def realGate (g : Gate) : Bool :=
  (g.f10 || g.f01 || g.f11) && !(g.f10 && !g.f01 && g.f11) && !(!g.f10 && g.f01 && g.f11)

def circuit : List Gate := [
  ⟨1, 2, true, true, false⟩,
  ⟨4, 5, true, true, false⟩,
  ⟨3, 6, true, true, false⟩,
  ⟨2, 8, true, true, false⟩,
  ⟨4, 8, true, true, false⟩,
  ⟨6, 9, true, true, true⟩,
  ⟨7, 10, true, true, true⟩,
  ⟨11, 12, false, false, true⟩,
  ⟨8, 13, true, true, false⟩
]

def output (x1 x2 x3 x4 x5 : Bool) : Bool := (run circuit [x1, x2, x3, x4, x5]).getD 13 false

theorem gate_count : circuit.length = 9 := by decide
theorem well_formed : wellFormed circuit 5 = true := by decide
theorem all_real_gates : circuit.all realGate = true := by decide

/-- **The circuit computes majority of five** on every one of the 32 inputs. -/
theorem computes_majority_of_five :
    ∀ x1 x2 x3 x4 x5 : Bool, output x1 x2 x3 x4 x5 = decide (3 ≤ x1.toNat + x2.toNat + x3.toNat + x4.toNat + x5.toNat) := by
  decide

end PnpFormal.Maj5

#print axioms PnpFormal.Maj5.gate_count
#print axioms PnpFormal.Maj5.well_formed
#print axioms PnpFormal.Maj5.all_real_gates
#print axioms PnpFormal.Maj5.computes_majority_of_five
